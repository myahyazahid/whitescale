---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ProcessDark from '../components/ProcessDark.astro';
import BigNumber from '../components/BigNumber.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
---

<Base title="Proses Pembuatan Website & Aplikasi | whitescale" description="Cara whitescale membangun website dan aplikasi: konsultasi gratis, desain di Figma, development per sprint dua minggu, rilis, dan garansi bug tiga bulan.">
  <PageHero label="Proses" title="Cara kami bekerja, tanpa kejutan" lead="Langkah yang sama untuk proyek kecil maupun besar, jadi kamu selalu tahu proyek sedang di mana dan apa yang berikutnya." />
  <ProcessDark showHead={false} />
  <BigNumber value={7} suffix=" hari" title="Setiap tujuh hari ada versi baru yang bisa kamu coba." />
  <Faq />
  <CtaBand />
</Base>
