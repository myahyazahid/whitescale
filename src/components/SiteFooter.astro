---
import { site, nav, services, waLink } from '../data/site';
import Logo from './Logo.astro';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
---

<footer class="band footer">
  <div class="frame">
    <div class="top">
      <div class="intro">
        <Logo />
        <p class="muted">Studio software untuk website, aplikasi mobile, dan sistem custom.</p>
        <a class="btn btn-outline" href={waLink('Halo, saya mau konsultasi gratis.')} target="_blank" rel="noopener">
          <Icon name="chat" size={14} /> Konsultasi gratis
        </a>
      </div>
      <div class="cols">
        <ul>
          <li><a href="/">Beranda</a></li>
          {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        </ul>
        <ul>
          {services.map((s) => <li><a href="/layanan">{s.title}</a></li>)}
        </ul>
        <ul>
          <li><a href={waLink('Halo!')} target="_blank" rel="noopener">WhatsApp</a></li>
          <li><a href={`mailto:${site.email}`}>Email</a></li>
          {site.social.map((s) => <li><a href={s.href} target="_blank" rel="noopener">{s.label}</a></li>)}
        </ul>
      </div>
    </div>
    <div class="bottom">
      <p>© {year} {site.name}. Semua hak dilindungi.</p>
      <p class="mono">{site.address.city}</p>
    </div>
  </div>
</footer>

<style>
  .footer { border-bottom: 0; }
  .top { display: grid; grid-template-columns: 1fr 2fr; border-bottom: 1px solid var(--line); }
  .intro { display: grid; gap: 1rem; align-content: start; justify-items: start; padding: 3rem var(--pad); border-right: 1px solid var(--line); }
  .intro p { max-width: 30ch; font-size: 15px; }
  .cols { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; padding: 3rem var(--pad); }
  .cols ul { display: grid; gap: 1rem; align-content: start; font-family: var(--mono); font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase; }
  .cols a { color: var(--ink-soft); transition: color 160ms ease; }
  .cols a:hover { color: var(--brand-text); }
  .bottom { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 1.5rem var(--pad); font-size: 14px; color: var(--muted); }

  @media (max-width: 860px) {
    .top { grid-template-columns: 1fr; }
    .intro { border-right: 0; border-bottom: 1px solid var(--line); }
    .cols { grid-template-columns: 1fr 1fr; }
    .bottom { flex-direction: column; align-items: flex-start; }
  }
</style>
