---
import { services, waLink } from '../data/site';
import Icon from './Icon.astro';
---

<section class="band" aria-labelledby="detail-title">
  <div class="frame">
    <div class="inner">
      <h2 class="sr-only" id="detail-title">Rincian layanan</h2>
      <div class="grid">
        {services.map((s, i) => (
          <article class="card" data-reveal style={`--i: ${i % 2}`}>
            <div class="top">
              <Icon name={s.icon} size={24} />
              <span class="mono tag">{s.tag}</span>
            </div>
            <h3 class="h3">{s.title}</h3>
            <p class="muted">{s.text}</p>
            <ul>
              {s.items.map(([name, desc]) => (
                <li><span class="name">{name}</span><span class="desc">{desc}</span></li>
              ))}
            </ul>
            <a class="btn btn-outline" href={waLink(`Halo, saya mau diskusi soal ${s.title}.`)} target="_blank" rel="noopener">Diskusi {s.title} <Icon name="arrow" /></a>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .card { display: grid; gap: 0.9rem; align-content: start; justify-items: start; padding: 1.75rem; background: var(--card); border-radius: var(--radius); }
  .top { display: flex; justify-content: space-between; width: 100%; align-items: center; margin-bottom: 0.5rem; }
  .tag { font-size: 11px; color: var(--muted); }
  ul { width: 100%; margin: 0.5rem 0 0.75rem; border-top: 1px solid var(--line); }
  li { display: grid; grid-template-columns: 10rem 1fr; gap: 1rem; padding: 0.85rem 0; border-bottom: 1px solid var(--line); font-size: 14.5px; }
  .name { font-weight: 500; }
  .desc { color: var(--muted); }
  @media (max-width: 860px) {
    .grid { grid-template-columns: 1fr; }
    li { grid-template-columns: 1fr; gap: 0.15rem; }
  }
</style>
