---
// Garis-garis yang menyebar ke kiri-kanan dari satu titik temu di tengah.
const W = 1200, H = 760, cx = W / 2, cy = 420;
const count = 28;
const lines = Array.from({ length: count }, (_, i) => {
  const t = (i / (count - 1)) * 2 - 1;
  const yl = cy + t * 640;
  const yr = cy - t * 600;
  const d = `M -40 ${yl.toFixed(1)} C ${W * 0.3} ${yl.toFixed(1)}, ${cx - 140} ${cy}, ${cx} ${cy} C ${cx + 140} ${cy}, ${W * 0.7} ${yr.toFixed(1)}, ${W + 40} ${yr.toFixed(1)}`;
  const o = 0.12 + (1 - Math.abs(t)) * 0.22;
  return { d, o };
});
const travellers = [6, 11, 19, 23];
---

<svg class="lines" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  {lines.map((l, i) => <path id={`hl-${i}`} d={l.d} stroke="var(--brand)" stroke-opacity={l.o} fill="none" stroke-width="1" />)}
  <circle cx={cx} cy={cy} r="3" fill="var(--brand)" opacity="0.6" />
  {travellers.map((i, k) => (
    <circle r="2.6" fill="var(--brand)" class="dot">
      <animateMotion dur={`${7 + k * 1.7}s`} begin={`${k * 1.3}s`} repeatCount="indefinite" keyPoints={k % 2 ? '1;0' : '0;1'} keyTimes="0;1" calcMode="linear">
        <mpath href={`#hl-${i}`} />
      </animateMotion>
    </circle>
  ))}
</svg>

<style>
  .lines { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  @media (prefers-reduced-motion: reduce) { .dot { display: none; } }
</style>
