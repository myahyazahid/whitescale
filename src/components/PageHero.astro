---
interface Props { label: string; title: string; lead: string }
const { label, title, lead } = Astro.props;
---

<section class="band page-hero">
  <div class="frame">
    <div class="glow" aria-hidden="true"></div>
    <div class="content">
      <p class="label">{label}</p>
      <h1 class="h1">{title}</h1>
      <p class="lead">{lead}</p>
      {Astro.slots.has('default') && <div class="actions"><slot /></div>}
    </div>
  </div>
</section>

<style>
  .frame { position: relative; overflow: hidden; }
  .glow {
    position: absolute; inset: 0 0 auto; height: 260px;
    background:
      radial-gradient(60% 100% at 40% 0%, rgba(110, 84, 255, 0.16), transparent 70%),
      radial-gradient(40% 80% at 85% 0%, rgba(255, 161, 161, 0.16), transparent 70%);
  }
  .content { position: relative; display: grid; gap: 1.25rem; justify-items: center; text-align: center; padding: clamp(5rem, 10vw, 8rem) var(--pad) clamp(4rem, 7vw, 5.5rem); }
  .h1 { max-width: 18ch; font-size: clamp(2.25rem, 1.4rem + 2.6vw, 3.5rem); }
  .lead { max-width: 54ch; }
  .actions { display: flex; gap: 0.75rem; flex-wrap: wrap; justify-content: center; margin-top: 0.75rem; }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .content > * { opacity: 0; transform: translateY(12px); animation: rise 800ms var(--ease-expo) forwards; }
    :global(.js) .content > :nth-child(2) { animation-delay: 70ms; }
    :global(.js) .content > :nth-child(3) { animation-delay: 140ms; }
    :global(.js) .content > :nth-child(4) { animation-delay: 210ms; }
  }
  @keyframes rise { to { opacity: 1; transform: none; } }
</style>
