---
import { services } from '../data/site';
import SectionHead from './SectionHead.astro';
import Icon from './Icon.astro';

interface Props { showHead?: boolean }
const { showHead = true } = Astro.props;
---

<section class="band" aria-labelledby="layanan-title">
  <div class="frame">
    {showHead && (
      <div class="inner pad-bottom-0">
        <SectionHead label="Layanan" id="layanan-title" title="Satu tim untuk semua kebutuhan digitalmu" text="Dari website pertama sampai sistem yang dipakai ratusan karyawan, dikerjakan tim yang sama: desainer, engineer, dan QA.">
          <a slot="action" class="btn btn-outline" href="/layanan">Semua layanan <Icon name="arrow" /></a>
        </SectionHead>
      </div>
    )}
    {!showHead && <h2 id="layanan-title" class="sr-only">Layanan</h2>}
    <ul class="row">
      {services.map((s, i) => (
        <li data-reveal style={`--i: ${i}`}>
          <Icon name={s.icon} size={24} class="ic" />
          <h3 class="h3">{s.title}</h3>
          <p class="muted">{s.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .pad-bottom-0 { padding-bottom: 0; }
  .row { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--line); }
  li { padding: 2.5rem var(--pad) 3.5rem; display: grid; gap: 0.75rem; align-content: start; }
  li + li { border-left: 1px solid var(--line); }
  :global(.ic) { color: var(--ink); margin-bottom: 1.25rem; }
  li p { font-size: 15px; }

  @media (max-width: 960px) {
    .row { grid-template-columns: 1fr 1fr; }
    li:nth-child(3) { border-left: 0; }
    li:nth-child(n + 3) { border-top: 1px solid var(--line); }
  }
  @media (max-width: 560px) {
    .row { grid-template-columns: 1fr; }
    li + li { border-left: 0; border-top: 1px solid var(--line); }
  }
</style>
