---
interface Props {
  label: string;
  title: string;
  text?: string;
  id?: string;
  as?: 'h1' | 'h2';
}
const { label, title, text, id, as: Tag = 'h2' } = Astro.props;
---

<div class="split head">
  <div class="left">
    <p class="label" data-reveal>{label}</p>
    <Tag class={Tag === 'h1' ? 'h1' : 'h2'} id={id} data-reveal style="--i: 1">{title}</Tag>
    {Astro.slots.has('action') && <div class="action" data-reveal style="--i: 2"><slot name="action" /></div>}
  </div>
  {text && <p class="lead text" data-reveal style="--i: 2">{text}</p>}
</div>

<style>
  .head { margin-bottom: clamp(2.5rem, 5vw, 3.5rem); }
  .left { display: grid; gap: 1rem; justify-items: start; }
  .action { margin-top: 0.75rem; display: flex; gap: 0.75rem; flex-wrap: wrap; }
  .text { max-width: 44ch; justify-self: end; }
  @media (max-width: 860px) { .text { justify-self: start; } }
</style>
